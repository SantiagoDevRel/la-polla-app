[Unit]
Description=La Polla: backup cifrado de Supabase (export, verify, tar | zstd | gpg)
Documentation=https://github.com/SantiagoDevRel/la-polla-app/blob/main/ops/backup/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/apps/la-polla-backup-runner
ExecStart=%h/apps/la-polla-backup-runner/ops/backup/run-backup.sh
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
Environment=NODE_OPTIONS=--max-old-space-size=4096
SyslogIdentifier=la-polla-backup
