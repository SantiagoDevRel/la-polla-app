[Unit]
Description=La Polla: verificación diaria de los snapshots cifrados (sha256, destinatario, frescura)
Documentation=https://github.com/SantiagoDevRel/la-polla-app/blob/main/ops/backup/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/apps/la-polla-backup-runner
ExecStart=%h/apps/la-polla-backup-runner/ops/backup/verify-snapshots.sh
TimeoutStartSec=60min
UMask=0077
Nice=10
NoNewPrivileges=yes
SyslogIdentifier=la-polla-backup-verify
