[Unit]
Description=La Polla: backup cada 6 h (00, 06, 12 y 18:10 hora Bogotá)
Documentation=https://github.com/SantiagoDevRel/la-polla-app/blob/main/ops/backup/README.md

[Timer]
OnCalendar=*-*-* 00,06,12,18:10:00 America/Bogota
Persistent=true
RandomizedDelaySec=120
AccuracySec=1min
Unit=la-polla-backup.service

[Install]
WantedBy=timers.target
