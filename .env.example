# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp Cloud API
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_WEBHOOK_VERIFY_TOKEN=

# API-Football
API_FOOTBALL_KEY=

# Cloudflare Turnstile
# Para desarrollo local usa las keys de prueba de Cloudflare:
# Site: 1x00000000000000000000AA  Secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cron / Admin sync (server-side only — never use NEXT_PUBLIC_ prefix)
CRON_SECRET=

# Meta WhatsApp App Secret (for webhook signature verification)
META_WA_APP_SECRET=

# App
# También arma el ackurl de LabsMobile (`/api/sms/ack`). En prod: el origen
# canónico que NO redirige (https://lapollacolombiana.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LabsMobile — envío de OTP via "Send SMS Hook" de Supabase Auth.
# El hook SOLO entrega el código; Supabase lo genera y lo valida.
# Cutover: Auth → Hooks → Send SMS Hook → HTTP →
#   https://lapollacolombiana.com/api/auth/sms-hook
# Hasta ese switch, Twilio Verify sigue siendo el proveedor activo.
LABSMOBILE_USERNAME=
LABSMOBILE_TOKEN=
# Secreto que da Supabase al crear el hook, formato "v1,whsec_..."
SEND_SMS_HOOK_SECRET=
# Gatea /api/sms/ack (callback de entrega). Viaja DENTRO del ackurl.
SMS_ACK_SECRET=
# Opcional: LABSMOBILE_DRY_RUN=1 simula el envío (code 0, no entrega).

# SSO handoff signing key — used by /api/auth/handoff + /api/auth/consume
# para mantener al user logueado al toggle-ar idioma en /perfil
# (lapollacolombiana.com ↔ chickenpicks.app). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Mínimo 32 chars. Mismo valor en local + Vercel (todos los environments).
HANDOFF_SECRET=

# Login alternativo por Telegram — bot PÚBLICO, distinto del bot admin.
# Las tres o ninguna: si falta alguna, /login no muestra la opción y el webhook
# (/api/telegram/login) responde 503. Token de @BotFather; el secreto es el
# secret_token del setWebhook (32-256 caracteres A-Z a-z 0-9 _ -). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Registro: node --env-file=.env.local scripts/telegram-login-set-webhook.mjs
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_WEBHOOK_SECRET=
# Usuario del bot, sin @ (público: arma el enlace t.me/<bot>?start=login).
NEXT_PUBLIC_TELEGRAM_LOGIN_BOT_USERNAME=
# Opcional (decisión del dueño). Vacío: una cuenta que ya existía por SMS solo
# entra por SMS, porque Telegram puede conservar un número reciclado del dueño
# anterior. true: la primera cuenta de Telegram que entra a esa cuenta queda
# vinculada y ninguna otra puede usarla.
TELEGRAM_LOGIN_ALLOW_EXISTING_ACCOUNTS=

# Admin — teléfonos exentos del tope diario de SMS (app/api/auth/start-otp).
# E.164 sin "+", separados por coma. Mismo valor en local + Vercel.
ADMIN_PHONES_E164=

# Owner usado por scripts/seed-test-data.ts para ubicar tu cuenta. E.164 sin "+".
SEED_OWNER_PHONE=

# Tester user IDs (UUID) que saltan el cap de comprobantes (payment-proof).
# Separados por coma. Vacío = nadie bypassa el cap.
TESTER_USER_IDS=
